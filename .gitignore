# Dependencies
node_modules/

# Azure Functions local config (contains API key)
api/local.settings.json

# Worker config (contains storage connection string)
worker/worker.config.json

# Azurite local storage data
.azurite/

# Agent credentials and configs (contain secrets)
*/config.json

# Compiled binaries
approver/dist/
*/dist/

# Agent log files and operational payloads (contain tenant UPNs / run data)
*/logs/
*/approver-payload.json

# Audit log (sensitive operational data)
audit.jsonl

# Operator PIN/Windows-auth hashes - must never be committed
approver/operator-auth.json
# Operator RBAC - names real operators / tenant UPNs (commit operators.example.json)
approver/operators.json
# Per-operator activity log (contains operator names + event types)
approver/operator-activity.jsonl
# AI run telemetry (runtime observability data)
approver/ai-traces.jsonl
# AI provider config (contains API keys)
approver/ai-provider.json
# Foundry IQ grounding config (contains the knowledge/search key)
approver/foundry-iq.json
# Lifecycle operation history (runtime state, contains tenant UPNs)
approver/operations.jsonl
# Scheduled operations queue (runtime state)
approver/scheduled.json
# Notification routing rules - operator-specific, optional to commit
approver/notification-rules.json
# Durable tenant binding written by the setup wizard (contains the live tenant ID/domain)
approver/tenant.json
# Security finding ownership - maps finding -> real operator UPN
approver/security-assignments.json
# Shared finding status (acknowledged/deleted findings) - references real findings
approver/security-status.json

# Auditor report outputs (contain tenant UPNs / security findings)
auditor/reports/

# Electron build output
electron-app/out/
electron-app/dist/

# Local state backups - may contain tenant UPNs, PIN hashes, or tenant IDs.
# Never commit; these are runtime/recovery copies, not source.
*.bak
*.fresh-bak
*.oobebak

# Misc
.superpowers/
*.tmp
.DS_Store
Thumbs.db
.superpowers/jml-demo-video/scripts/azure-speech.json
# PIM / access-cert configs hold real tenant group & object IDs
shared/pim-config.json
shared/access-cert-config.json

# AI-assistant tooling - keep local, never on the public repo
.claude/
CLAUDE.md
docs/superpowers/
electron-app/docs/superpowers/
