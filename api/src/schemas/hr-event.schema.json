{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jml.local/schemas/hr-event.json",
  "title": "HR Lifecycle Event",
  "description": "Canonical event schema for JML (Joiner/Mover/Leaver) lifecycle triggers",
  "type": "object",
  "required": ["eventType", "effectiveDate", "employee"],
  "properties": {
    "eventId": {
      "type": "string",
      "description": "UUID — generated by API if omitted"
    },
    "eventType": {
      "type": "string",
      "enum": ["hire", "terminate", "transfer"]
    },
    "effectiveDate": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date (YYYY-MM-DD). Future dates are accepted; worker processes on the day."
    },
    "source": {
      "type": "string",
      "enum": ["mock", "bamboohr", "workday", "api"],
      "default": "api"
    },
    "ticketRef": {
      "type": "string",
      "description": "ITSM ticket reference. Required for eventType=terminate."
    },
    "employee": {
      "type": "object",
      "required": ["firstName", "lastName", "email"],
      "properties": {
        "employeeId":     { "type": "string" },
        "firstName":      { "type": "string", "minLength": 1 },
        "lastName":       { "type": "string", "minLength": 1 },
        "email":          { "type": "string", "format": "email" },
        "department":     { "type": "string" },
        "jobTitle":       { "type": "string" },
        "usageLocation":  { "type": "string", "minLength": 2, "maxLength": 2, "description": "ISO 3166-1 alpha-2 country code" },
        "manager":        { "type": "string", "format": "email", "description": "UPN of the manager" },
        "officeLocation": { "type": "string" },
        "groups":         { "type": "array", "items": { "type": "string" }, "description": "M365 group display names to assign on hire" },
        "licenses":       { "type": "array", "items": { "type": "string" }, "description": "License SKU names to assign on hire (e.g. Microsoft_Entra_Suite)" }
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "object",
      "description": "Required for eventType=transfer. Describes what is changing.",
      "properties": {
        "previousDepartment": { "type": "string" },
        "newDepartment":      { "type": "string" },
        "previousTitle":      { "type": "string" },
        "newTitle":           { "type": "string" },
        "previousManager":    { "type": "string" },
        "newManager":         { "type": "string" },
        "groupsToAdd":        { "type": "array", "items": { "type": "string" } },
        "groupsToRemove":     { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "if": {
    "properties": { "eventType": { "const": "terminate" } }
  },
  "then": {
    "required": ["ticketRef"]
  }
}
