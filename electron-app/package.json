{
  "name": "jml-console",
  "version": "1.1.14",
  "description": "JML Identity Management Console",
  "author": "Nicholas Bohanan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "capture": "electron . --capture --disable-gpu",
    "build": "electron-builder --win --x64",
    "test": "node --test \"test/**/*.test.js\""
  },
  "build": {
    "appId": "com.jml.console",
    "productName": "JML Console",
    "artifactName": "JML.Console-${version}-win.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "TrickyDanceMoves",
        "repo": "jml-agent-fleet"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "msi",
        "zip"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "JML.Console.Setup.${version}.${ext}"
    },
    "msi": {
      "perMachine": false,
      "upgradeCode": "1EE847D0-E748-4A43-B2B3-2CDC7F89447E",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "JML.Console.${version}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-panel.js",
      "preload-overlay.js",
      "lib/**/*",
      "providers/**/*",
      "renderer/**/*",
      "Assets/icon.ico"
    ],
    "extraResources": [
      {
        "from": "../joiner",
        "to": "agents/joiner",
        "filter": [
          "**/*.ps1"
        ]
      },
      {
        "from": "../mover",
        "to": "agents/mover",
        "filter": [
          "**/*.ps1"
        ]
      },
      {
        "from": "../leaver",
        "to": "agents/leaver",
        "filter": [
          "**/*.ps1"
        ]
      },
      {
        "from": "../enroller",
        "to": "agents/enroller",
        "filter": [
          "**/*.ps1"
        ]
      },
      {
        "from": "../approver",
        "to": "agents/approver",
        "filter": [
          "**/*.ps1"
        ]
      },
      {
        "from": "../auditor",
        "to": "agents/auditor",
        "filter": [
          "**/*.ps1"
        ]
      },
      {
        "from": "../certifier",
        "to": "agents/certifier",
        "filter": [
          "**/*.ps1"
        ]
      },
      {
        "from": "../provisioner",
        "to": "agents/provisioner",
        "filter": [
          "**/*.ps1"
        ]
      },
      {
        "from": "../shared",
        "to": "agents/shared",
        "filter": [
          "**/*.ps1",
          "*.json"
        ]
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "@azure/data-tables": "^13.3.0",
    "@azure/identity": "^4.13.1",
    "@azure/storage-queue": "^12.23.0",
    "electron-updater": "^6.8.9",
    "openai": "^4.96.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "electron": "^42.5.1",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1"
  }
}
